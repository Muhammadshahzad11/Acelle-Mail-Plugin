{
    "name": "muhammad.dev.pro/acelle-mailer-extended",
    "description": "An extended package for acelle mail plugin.",
    "keywords": [
        "muhammad.dev.pro",
        "acelle-mailer-extended"
    ],
    "homepage": "https://github.com/muhammad.dev.pro/acelle-mailer-extended",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Shah Sawood",
            "email": "shahsawoodshinwari@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/support": "^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Muhammad.dev.pro\\AcelleMailerExtended\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Muhammad.dev.pro\\AcelleMailerExtended\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"

    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Muhammad.dev.pro\\AcelleMailerExtended\\AcelleMailerExtendedServiceProvider"
            ],
            "aliases": {
                "AcelleMailerExtended": "Muhammad.dev.pro\\AcelleMailerExtended\\AcelleMailerExtendedFacade"
            }
        }
    }
}
